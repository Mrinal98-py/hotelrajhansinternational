# Database (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Authentication & Security
JWT_SECRET="generate-a-strong-random-32-byte-secret-for-jwt"
NEXTAUTH_SECRET="generate-a-strong-random-32-byte-secret-for-nextauth"
NEXT_PUBLIC_SITE_URL="https://hotelrajhansinternational.com"
NEXT_PUBLIC_APP_URL="https://hotelrajhansinternational.vercel.app"

# Cashfree Payment Gateway (Production / Sandbox)
CASHFREE_APP_ID="your_cashfree_app_id"
CASHFREE_SECRET_KEY="your_cashfree_secret_key"
CASHFREE_CLIENT_ID="your_cashfree_app_id"
CASHFREE_CLIENT_SECRET="your_cashfree_secret_key"
CASHFREE_ENV="PRODUCTION"
CASHFREE_API_VERSION="2023-08-01"

# SMTP Transactional Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="info@hotelrajhansinternational.com"
SMTP_PASS="your_email_app_password"
SMTP_FROM="Hotel Rajhans International <info@hotelrajhansinternational.com>"

# Google Sheets Synchronization (Optional)
GOOGLE_SHEET_ID="your_google_sheet_id"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Hotel Tax Configuration
HOTEL_GSTIN="10AAAAA0000A1Z5"
DEFAULT_GST_PERCENTAGE="12"
