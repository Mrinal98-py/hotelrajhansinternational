datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

enum Role {
  SUPER_ADMIN
  MANAGER
  RECEPTION
  STAFF
}

enum RoomType {
  EXECUTIVE
  DELUXE
  ROYAL_SUITE
  DORMITORY
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  OCCUPIED
  DEACTIVATED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  CASH
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  RESOLVED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  FEATURED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         Role       @default(STAFF)
  avatar       String?
  phone        String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  auditLogs    AuditLog[]
}

model Room {
  id              String         @id @default(uuid())
  name            String
  slug            String         @unique
  type            RoomType
  description     String
  capacity        Int            @default(2)
  basePriceSingle Float
  basePriceDouble Float
  weekendPrice    Float?
  holidayPrice    Float?
  extraBedPrice   Float          @default(500)
  taxPercentage   Float          @default(12)
  status          RoomStatus     @default(AVAILABLE)
  displayOrder    Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  images          RoomImage[]
  amenities       RoomAmenity[]
  availabilities  Availability[]
  bookings        Booking[]
}

model RoomImage {
  id           String   @id @default(uuid())
  roomId       String
  url          String
  alt          String?
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  room         Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model RoomAmenity {
  id          String @id @default(uuid())
  roomId      String
  amenityName String
  room        Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Availability {
  id     String @id @default(uuid())
  roomId String
  date   String // Format YYYY-MM-DD
  status String // AVAILABLE, BOOKED, MAINTENANCE, BLOCKED
  reason String?
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
}

model Customer {
  id             String    @id @default(uuid())
  name           String
  phone          String    @unique
  email          String?
  address        String?
  idProofNumber  String?
  vipStatus      Boolean   @default(false)
  visitCount     Int       @default(0)
  totalSpent     Float     @default(0)
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]
}

model Booking {
  id              String        @id @default(uuid())
  referenceId     String        @unique // e.g. HRJ-20260801-0001
  customerId      String
  roomId          String
  checkIn         DateTime
  checkOut        DateTime
  guestsCount     Int           @default(2)
  adults          Int           @default(2)
  children        Int           @default(0)
  specialRequests String?
  totalAmount     Float
  taxAmount       Float
  discountAmount  Float         @default(0)
  netAmount       Float
  paidAmount      Float         @default(0)
  status          BookingStatus @default(PENDING)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  customer        Customer      @relation(fields: [customerId], references: [id])
  room            Room          @relation(fields: [roomId], references: [id])
  payments        Payment[]
}

model Payment {
  id                String        @id @default(uuid())
  bookingId         String
  cashfreeOrderId   String?
  cashfreePaymentId String?
  amount            Float
  currency          String        @default("INR")
  method            PaymentMethod @default(UPI)
  status            PaymentStatus @default(PENDING)
  gatewayResponse   String?
  createdAt         DateTime      @default(now())
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model GalleryImage {
  id           String   @id @default(uuid())
  url          String
  alt          String
  category     String   // reception, rooms, restaurant, services, icecream, dormitory
  size         String   @default("square") // square, tall, wide
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  message   String
  status    MessageStatus @default(UNREAD)
  replyText String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Review {
  id             String       @id @default(uuid())
  authorName     String
  authorInitials String
  rating         Int          @default(5)
  reviewText     String
  source         String       @default("Website") // Google, Website, Direct
  status         ReviewStatus @default(PENDING)
  createdAt      DateTime     @default(now())
}

model FAQ {
  id           String   @id @default(uuid())
  question     String
  answer       String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("general") // general, contact, cms, policy, financial
  description String?
  updatedAt   DateTime @updatedAt
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    @default("PERCENTAGE") // PERCENTAGE or FLAT
  discountValue Float
  validFrom     DateTime?
  validUntil    DateTime?
  maxUses       Int       @default(100)
  usedCount     Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}
